@model FleetLog.ViewModels.VehicleAssignmentCreateViewModel

@{
    ViewData["Title"] = "Назначаване на автомобил";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<h1>Назначаване на автомобил</h1>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="fleet-form-panel">
            @if (Model.AvailableVehicles.Count == 0)
            {
                <p>Няма активни автомобили за назначаване.</p>
            }

            @if (Model.AvailableDrivers.Count == 0)
            {
                <p>Няма активни шофьори. Първо добавете шофьор.</p>
            }

            <form asp-area="Admin"
                  asp-controller="VehicleAssignments"
                  asp-action="Create"
                  method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="VehicleId" class="form-label"></label>
                    <select asp-for="VehicleId"
                            asp-items="Model.AvailableVehicles"
                            class="form-select">
                        <option value="">— Изберете автомобил —</option>
                    </select>
                    <span asp-validation-for="VehicleId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DriverId" class="form-label"></label>
                    <select asp-for="DriverId"
                            asp-items="Model.AvailableDrivers"
                            class="form-select">
                        <option value="">— Изберете шофьор —</option>
                    </select>
                    <span asp-validation-for="DriverId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StartDate" class="form-label"></label>
                    <input asp-for="StartDate" class="form-control" />
                    <span asp-validation-for="StartDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate"
                           class="form-control"
                           aria-describedby="endDateHelp" />
                    <div id="endDateHelp" class="form-text">
                        Оставете празно, ако няма определена крайна дата.
                        Крайната дата е включена в периода.
                    </div>
                    <span asp-validation-for="EndDate"
                          class="text-danger"></span>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Запази
                    </button>

                    <a asp-area="Admin"
                       asp-controller="VehicleAssignments"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Отказ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
}