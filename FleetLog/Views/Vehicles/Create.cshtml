@model FleetLog.ViewModels.VehicleCreateViewModel

@{
    ViewData["Title"] = "Добавяне на автомобил";
}

<h1>Добавяне на автомобил</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Vehicles" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <partial name="_VehicleFormFields" model="Model" />
            
            <button type="submit" class="btn btn-primary">Запази</button>

            <a asp-controller="Vehicles" asp-action="Index" class="btn btn-secondary">
                Назад към автомобилите
            </a>

        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}