@model FleetLog.ViewModels.VehicleFuelHistoryViewModel

@{
    ViewData["Title"] = "Зареждания";
}

<h1>Зареждания — @Model.RegistrationNumber</h1>
<p>
    <a asp-controller="FuelEntries"
       asp-action="Create"
       asp-route-vehicleId="@Model.VehicleId"
       class="btn btn-primary">
        Добавяне на зареждане
    </a>
</p>
@if (!Model.FuelEntries.Any())
{
    <p>Все още няма записани зареждания за този автомобил.</p>
}
else
{
    <div class="table-responsive fleet-table-panel">
        <table class="table align-middle mb-0">
            <thead class="text-nowrap">
            <tr>
                <th>Дата</th>
                <th>Литри</th>
                <th>Обща сума</th>
                <th>Километраж (км)</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var entry in Model.FuelEntries)
            {
                <tr>
                    <td class="text-nowrap">
                        @entry.Date.ToString("dd.MM.yyyy")
                    </td>
                    <td>@entry.Litres.ToString("F2")</td>
                    <td>@entry.TotalCost.ToString("F2")</td>
                    <td>@entry.MileageKm</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="mt-4">
    <a asp-controller="Vehicles"
       asp-action="Details"
       asp-route-id="@Model.VehicleId"
       class="btn btn-secondary">
        Назад към автомобила
    </a>
</div>