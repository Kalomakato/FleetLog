@model FleetLog.ViewModels.FuelEntryCreateViewModel

@{
    ViewData["Title"] = "Добавяне на зареждане";
}

<h1>Добавяне на зареждане — @Model.RegistrationNumber</h1>

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="fleet-form-panel">
            <form asp-controller="FuelEntries"
                  asp-action="Create"
                  method="post">

                <input asp-for="VehicleId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="Date"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Litres" class="form-label"></label>
                    <input asp-for="Litres"
                           type="number"
                           step="0.01"
                           data-val-number="Въведете валидно число за литрите."
                           class="form-control" />
                    <span asp-validation-for="Litres"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TotalCost" class="form-label"></label>
                    <input asp-for="TotalCost"
                           type="number"
                           step="0.01"
                           data-val-number="Въведете валидно число за общата сума."
                           class="form-control" />
                    <span asp-validation-for="TotalCost"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MileageKm" class="form-label"></label>
                    <input asp-for="MileageKm"
                           type="number"
                           step="1"
                           data-val-number="Въведете валидно число за километража."
                           class="form-control" />
                    <span asp-validation-for="MileageKm"
                          class="text-danger"></span>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Запази
                    </button>

                    <a asp-controller="FuelEntries"
                       asp-action="Index"
                       asp-route-vehicleId="@Model.VehicleId"
                       class="btn btn-secondary">
                        Отказ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}