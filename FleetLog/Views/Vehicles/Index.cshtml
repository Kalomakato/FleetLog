@model IEnumerable<FleetLog.ViewModels.VehicleListViewModel>

@{
    ViewData["Title"] = "Автомобили";
    
}

<h1>Автомобили</h1>
<p>
    <a asp-controller="Vehicles" asp-action="Create" class="btn btn-primary">
        Добавяне на автомобил
    </a>
</p>
    @if (!Model.Any())
    {
        <p>Все още няма добавени автомобили.</p>
    }
    
    else
    {
        <table class="table">
            <thead>
            <tr>
                <th>Регистрационен номер</th>
                <th>Марка</th>
                <th>Модел</th>
                <th>Година</th>
                <th>Километраж (км)</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var vehicle in Model)
            {
                <tr>
                    <td>@vehicle.RegistrationNumber</td>
                    <td>@vehicle.Make</td>
                    <td>@vehicle.Model</td>
                    <td>@vehicle.Year</td>
                    <td>@vehicle.CurrentMileageKm</td>
                    <td>@(vehicle.IsActive ? "Активен" : "Неактивен")</td>
                    <td>
                        <a asp-controller="Vehicles"
                           asp-action="Details"
                           asp-route-id="@vehicle.Id"
                           class="btn btn-primary btn-sm">
                            Детайли
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
   