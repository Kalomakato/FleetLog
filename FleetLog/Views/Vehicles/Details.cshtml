@model FleetLog.ViewModels.VehicleDetailsViewModel
@using FleetLog.Data.Enums

@{
    ViewData["Title"] = "Детайли за автомобила";
}

<div class="fleet-page-header">
    <div>
        <h1>@Model.RegistrationNumber</h1>
        <p>@Model.Make @Model.Model — @Model.Year</p>
    </div>

    <a asp-controller="Vehicles"
       asp-action="Index"
       class="btn btn-secondary">
        Назад към автомобилите
    </a>
</div>

<div class="fleet-details-panel">
    <h2>Данни за автомобила</h2>

    <dl class="fleet-details-list">
        <dt>Регистрационен номер</dt>
        <dd>@Model.RegistrationNumber</dd>

        <dt>Марка</dt>
        <dd>@Model.Make</dd>

        <dt>Модел</dt>
        <dd>@Model.Model</dd>

        <dt>Година</dt>
        <dd>@Model.Year</dd>

        <dt>VIN</dt>
        <dd>@Model.VIN</dd>

        <dt>Километраж (км)</dt>
        <dd>@Model.CurrentMileageKm</dd>

        <dt>Статус</dt>
        <dd>
            <span class="fleet-status @(Model.IsActive ? "fleet-status-active" : "fleet-status-inactive")">
                @(Model.IsActive ? "Активен" : "Неактивен")
            </span>
        </dd>

        <dt>Гориво</dt>
        <dd>
            @(Model.FuelType switch
            {
                FuelType.Petrol => "Бензин",
                FuelType.Diesel => "Дизел",
                _ => "Неизвестно"
            })
        </dd>
    </dl>

    <div class="fleet-details-actions">
        <a asp-controller="FuelEntries"
           asp-action="Index"
           asp-route-vehicleId="@Model.Id"
           class="btn fleet-btn-fuel">
            Зареждания
        </a>

        <a asp-controller="Repairs"
           asp-action="Index"
           asp-route-vehicleId="@Model.Id"
           class="btn fleet-btn-repair">
            Ремонти
        </a>

        <a asp-controller="Vehicles"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn fleet-btn-edit">
            Редактиране
        </a>

        <a asp-controller="Vehicles"
           asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-outline-danger">
            Изтриване
        </a>
    </div>
</div>