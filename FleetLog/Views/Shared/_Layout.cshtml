<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FleetLog</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FleetLog.styles.css" asp-append-version="true" />
</head>
<body class="fleet-app">
<header class="fleet-header">
    <nav class="navbar navbar-expand-md navbar-light"
         aria-label="Основна навигация">
        <div class="container">
            <a class="navbar-brand"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">
                FleetLog
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation"
                    aria-expanded="false"
                    aria-label="Показване на навигацията">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="mainNavigation" class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-area=""
                           asp-controller="Home"
                           asp-action="Index">
                            Начало
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-area=""
                           asp-controller="Vehicles"
                           asp-action="Index">
                            Автомобили
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-area=""
                           asp-controller="Home"
                           asp-action="Privacy">
                            Поверителност
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="container fleet-content">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="fleet-footer">
    <div class="container">
        &copy; 2026 FleetLog
        <span class="mx-2" aria-hidden="true">·</span>
        <a asp-area=""
           asp-controller="Home"
           asp-action="Privacy">
            Поверителност
        </a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>