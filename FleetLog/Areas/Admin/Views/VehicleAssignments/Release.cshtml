@model FleetLog.ViewModels.VehicleAssignmentReleaseViewModel

@{
    ViewData["Title"] = "Освобождаване на автомобил";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<h1>Освобождаване на автомобил</h1>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="fleet-form-panel">
            <dl>
                <dt>Автомобил</dt>
                <dd>@Model.RegistrationNumber</dd>

                <dt>Шофьор</dt>
                <dd>@Model.DriverName</dd>

                <dt>Начална дата</dt>
                <dd>@Model.StartDate.ToString("dd.MM.yyyy")</dd>
            </dl>

            <form asp-area="Admin"
                  asp-controller="VehicleAssignments"
                  asp-action="Release"
                  method="post">
                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate"
                           class="form-control"
                           aria-describedby="releaseHelp" />
                    <span asp-validation-for="EndDate"
                          class="text-danger"></span>

                    <div id="releaseHelp" class="form-text">
                        Назначението ще остане в историята.
                        Крайната дата е включена в периода.
                        Ново назначение е възможно от следващия ден.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Потвърди освобождаването
                    </button>

                    <a asp-area="Admin"
                       asp-controller="VehicleAssignments"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Отказ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
}