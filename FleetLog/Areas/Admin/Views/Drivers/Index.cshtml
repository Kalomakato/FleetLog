@model List<FleetLog.ViewModels.DriverListViewModel>

@{
    ViewData["Title"] = "Шофьори";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1>Шофьори</h1>

    <a asp-area="Admin"
       asp-controller="Drivers"
       asp-action="Create"
       class="btn btn-primary">
        Добавяне на шофьор
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="fleet-form-panel">
        <p>Все още няма добавени шофьори.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr>
                <th scope="col">Име</th>
                <th scope="col">Имейл</th>
                <th scope="col">Статус</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var driver in Model)
            {
                <tr>
                    <td>@driver.FullName</td>
                    <td>@driver.Email</td>
                    <td>@(driver.IsActive ? "Активен" : "Неактивен")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<a asp-area="Admin"
   asp-controller="Home"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    Назад към администрацията
</a>