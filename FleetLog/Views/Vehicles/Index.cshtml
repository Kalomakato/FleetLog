@model IEnumerable<FleetLog.ViewModels.VehicleListViewModel>

@{
    ViewData["Title"] = "Автомобили";
}

<div class="fleet-page-header">
    <div>
        <h1>Автомобили</h1>
        <p>Данни, зареждания и ремонти за вашите автомобили.</p>
    </div>

    <a asp-controller="Vehicles"
       asp-action="Create"
       class="btn btn-primary">
        Добавяне на автомобил
    </a>
</div>

@if (!Model.Any())
{
    <div class="fleet-empty-state">
        <h2>Все още няма добавени автомобили.</h2>
        <p>Добавете първия си автомобил чрез бутона по-горе.</p>
    </div>
}
else
{
    <div class="table-responsive fleet-table-panel">
        <table class="table fleet-vehicles-table align-middle mb-0">
            <thead class="text-nowrap">
                <tr>
                    <th scope="col">Регистрационен номер</th>
                    <th scope="col">Марка</th>
                    <th scope="col">Модел</th>
                    <th scope="col">Година</th>
                    <th scope="col">Километраж (км)</th>
                    <th scope="col">Статус</th>
                    <th scope="col">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in Model)
                {
                    <tr>
                        <td class="fw-semibold text-nowrap">
                            @vehicle.RegistrationNumber
                        </td>
                        <td>@vehicle.Make</td>
                        <td>@vehicle.Model</td>
                        <td>@vehicle.Year</td>
                        <td>@vehicle.CurrentMileageKm</td>
                        <td>
                            <span class="fleet-status @(vehicle.IsActive ? "fleet-status-active" : "fleet-status-inactive")">
                                @(vehicle.IsActive ? "Активен" : "Неактивен")
                            </span>
                        </td>
                        <td>
                            <div class="fleet-row-actions">
                                <a asp-controller="Vehicles"
                                   asp-action="Details"
                                   asp-route-id="@vehicle.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Детайли
                                </a>

                                <a asp-controller="FuelEntries"
                                   asp-action="Index"
                                   asp-route-vehicleId="@vehicle.Id"
                                   class="btn fleet-btn-fuel btn-sm">
                                    Зареждания
                                </a>

                                <a asp-controller="Repairs"
                                   asp-action="Index"
                                   asp-route-vehicleId="@vehicle.Id"
                                   class="btn fleet-btn-repair btn-sm">
                                    Ремонти
                                </a>

                                <a asp-controller="Vehicles"
                                   asp-action="Edit"
                                   asp-route-id="@vehicle.Id"
                                   class="btn fleet-btn-edit btn-sm">
                                    Редактиране
                                </a>

                                <a asp-controller="Vehicles"
                                   asp-action="Delete"
                                   asp-route-id="@vehicle.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    Изтриване
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}