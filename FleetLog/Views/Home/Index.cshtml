@{
    ViewData["Title"] = "Начало";
}

<section class="fleet-hero text-center">
    <p class="fleet-eyebrow">FleetLog</p>

    <h1>Вашите автомобили.<br />Всичко на едно място.</h1>

    <p class="fleet-hero-description">
        Управлявайте автомобилите си и следете зарежданията,
        ремонтите и километража им.
    </p>

    <div class="d-flex flex-wrap justify-content-center gap-3">
        @if (User.IsInRole(FleetLog.Services.RoleNames.Administrator))
        {
            <a asp-area=""
               asp-controller="Vehicles"
               asp-action="Index"
               class="btn btn-primary">
                Към автомобилите
            </a>

            <a asp-area=""
               asp-controller="Vehicles"
               asp-action="Create"
               class="btn btn-secondary">
                Добавяне на автомобил
            </a>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-area=""
               asp-controller="MyVehicles"
               asp-action="Index"
               class="btn btn-primary">
                Моите автомобили
            </a>
        }
        else
        {
            <a asp-area=""
               asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary">
                Вход
            </a>

            <a asp-area=""
               asp-controller="Account"
               asp-action="Register"
               class="btn btn-secondary">
                Регистрация
            </a>
        }
    </div>
</section>

<section class="fleet-home-features" aria-label="Възможности на FleetLog">
    <div class="row g-4">
        <div class="col-12 col-md-4">
            <article class="fleet-feature-panel">
                <h2>Автомобили</h2>
                <p>
                    Основни данни, текущ километраж и статус
                    за всеки ваш автомобил.
                </p>
            </article>
        </div>

        <div class="col-12 col-md-4">
            <article class="fleet-feature-panel">
                <h2>Зареждания</h2>
                <p>
                    Записвайте количеството гориво и разходите.
                    Преглеждайте историята по дати.
                </p>
            </article>
        </div>

        <div class="col-12 col-md-4">
            <article class="fleet-feature-panel">
                <h2>Ремонти</h2>
                <p>
                    Пазете описанията на ремонтите, разходите
                    и информацията за сервиза.
                </p>
            </article>
        </div>
    </div>
</section>