@model FleetLog.ViewModels.VehicleEditViewModel

@{
    ViewData["Title"] = "Редактиране на автомобил";
}

<h1>Редактиране на автомобил</h1>


<div class="row">
    <div class="col-md-6">
        <form asp-controller="Vehicles" asp-action="Edit" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_VehicleFormFields" model="Model" />
            <button type="submit" class="btn btn-primary">Запази</button>

            <a asp-controller="Vehicles"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-secondary">
            Отказ
            </a>

        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}