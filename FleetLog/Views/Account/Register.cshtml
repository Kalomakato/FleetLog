@model FleetLog.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<h1>Регистрация</h1>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="fleet-form-panel">
            <form asp-controller="Account"
                  asp-action="Register"
                  method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="username" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-describedby="passwordHelp" />
                    <div id="passwordHelp" class="form-text">
                        Използвайте между 8 и 100 символа, включително
                        главна и малка латинска буква, цифра и специален символ.
                    </div>
                    <span asp-validation-for="Password"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger"></span>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Регистрация
                    </button>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-secondary">
                        Вече имам профил
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}